---
import { shareHref } from '../lib/share';

type Props = {
  url: string;
  title: string;
  summary: string;
};

const { url, title, summary } = Astro.props;
const payload = { url, title, summary };
---

<nav class="share-links" aria-label="Share this note">
  <a
    href={shareHref('x', payload)}
    rel="noopener noreferrer"
    target="_blank"
    title="Share on X"
    aria-label="Share on X"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.822L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      ></path>
    </svg>
  </a>
  <a
    href={shareHref('facebook', payload)}
    rel="noopener noreferrer"
    target="_blank"
    title="Share on Facebook"
    aria-label="Share on Facebook"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M22 12.07C22 6.48 17.52 2 12 2S2 6.48 2 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.03H7.9v-2.9h2.54V9.84c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.75 8.44-4.91 8.44-9.93Z"
      ></path>
    </svg>
  </a>
  <a
    href={shareHref('linkedin', payload)}
    rel="noopener noreferrer"
    target="_blank"
    title="Share on LinkedIn"
    aria-label="Share on LinkedIn"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.24.79 24 1.77 24h20.46c.98 0 1.77-.76 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"
      ></path>
    </svg>
  </a>
  <a href={shareHref('email', payload)} title="Share by email" aria-label="Share by email">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect
        x="3.25"
        y="5.75"
        width="17.5"
        height="12.5"
        rx="1.5"
        stroke="currentColor"
        stroke-width="1.4"></rect>
      <path
        d="M4 7.2 12 13.1 20 7.2"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
  <button type="button" class="share-copy" data-share-copy={url} title="Copy link" aria-label="Copy link">
    <svg class="share-icon-copy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect
        x="8.25"
        y="8.25"
        width="10.5"
        height="10.5"
        rx="1.4"
        stroke="currentColor"
        stroke-width="1.4"></rect>
      <path
        d="M15.5 8.1V6.7A1.45 1.45 0 0 0 14.05 5.25H6.7A1.45 1.45 0 0 0 5.25 6.7v7.35A1.45 1.45 0 0 0 6.7 15.5h1.4"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </svg>
    <svg class="share-icon-copied" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M5.5 12.5 10 17l8.5-9"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="share-copy-status" aria-live="polite"></span>
  </button>
</nav>

<script>
  const copiedMs = 2000;

  async function copyText(text: string): Promise<boolean> {
    if (!navigator.clipboard?.writeText) return false;
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function bindCopyButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share-copy]')) {
      if (button.dataset.shareBound === 'true') continue;
      button.dataset.shareBound = 'true';

      button.addEventListener('click', async () => {
        const url = button.dataset.shareCopy;
        if (!url) return;

        const copied = await copyText(url);
        if (!copied) return;

        const status = button.querySelector('.share-copy-status');
        button.dataset.copied = 'true';
        button.setAttribute('aria-label', 'Link copied');
        if (status) status.textContent = 'Link copied';

        window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', 'Copy link');
          if (status) status.textContent = '';
        }, copiedMs);
      });
    }
  }

  bindCopyButtons();
</script>
