---
import { site } from '../lib/brand';
---

<header class="hero" id="top">
  <div class="hero-inner">
    <h1 class="hero-logo">
      <img src="/brand/logo-gold.svg" width="720" height="102" alt={site.name} />
    </h1>
    <p class="hero-slogan" lang="de">
      {site.sloganLines[0]}
      <br />
      {site.sloganLines[1]}
    </p>
  </div>
  <nav class="hero-nav" aria-label="Page">
    <a href="#projects">Projects</a>
    <a href="#notes">Notes</a>
  </nav>
</header>
